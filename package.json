{
  "name": "pfm-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "pnpm --filter @pfm/mobile start",
    "lint": "eslint apps/mobile/src packages",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format:check": "prettier --check apps/mobile/src packages *.json *.yaml *.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
